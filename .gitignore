# Machine-local settings and caches
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json

# Skill engine binaries: the launcher downloads them on first run
**/scripts/bin/

# Symlink to an absolute path on one machine; reinstall from skills-lock.json
.claude/skills/design-taste-frontend

# Taste-skill inspector screenshots (regenerated on every run)
.taste-skill/inspect/
research_notes/
.playwright-mcp/

# Full MCP results the atlas-router mod trimmed out of context
.claude/tool-output/
# Type declarations the engine writes into each loaded mod
.claude/skills/*/.claude-plugin/types/
